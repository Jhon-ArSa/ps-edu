# ══════════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE PRODUCCIÓN — PS-EDU
# ══════════════════════════════════════════════════════════════════════════════
# Copiar este archivo a .env en el servidor de producción y configurar valores

# ── APLICACIÓN ────────────────────────────────────────────────────────────────
APP_NAME="PS-EDU FAEDU"
APP_ENV=production
APP_KEY=                                    # Generar con: php artisan key:generate
APP_DEBUG=false                             # ⚠️ SIEMPRE false en producción
APP_TIMEZONE=America/Lima
APP_URL=https://psedu.adesa.edu.pe          # URL real de producción

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ── LOGGING ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily                             # Rotación diaria de logs
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                           # Solo warnings y errores en producción

# ── SEGURIDAD: Logs de Seguridad ──────────────────────────────────────────────
# Los logs de seguridad se guardan en storage/logs/security.log
# Retención: 365 días
# Incluye: login, logout, intentos fallidos, bloqueos, recuperación de contraseña
# Revisar periódicamente: tail -f storage/logs/security.log
# ─────────────────────────────────────────────────────────────────────────────

# ── BASE DE DATOS ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=                                    # Host de AWS RDS
DB_PORT=3306
DB_DATABASE=psedu_production
DB_USERNAME=                                # Usuario de BD
DB_PASSWORD=                                # Contraseña segura

# ── SESIONES ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis                        # Redis para mejor rendimiento
SESSION_LIFETIME=30                         # 30 minutos para mayor seguridad
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.adesa.edu.pe               # Dominio para cookies
SESSION_SECURE_COOKIE=true                 # Solo HTTPS
SESSION_SAME_SITE=lax

# ── SEGURIDAD: Configuración de Sesiones ──────────────────────────────────────
# SESSION_LIFETIME reducido a 30 minutos para mayor seguridad
# SESSION_SECURE_COOKIE=true requiere HTTPS (obligatorio en producción)
# ─────────────────────────────────────────────────────────────────────────────

# ── BROADCAST ─────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ── FILESYSTEM ────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local                       # Cambiar a 's3' si se usa AWS S3

# ── COLAS ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis                      # Redis para colas en producción

# ── CACHE ─────────────────────────────────────────────────────────────────────
CACHE_STORE=redis                           # Redis para cache
CACHE_PREFIX=psedu_cache

# ── REDIS ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis                       # Más rápido que predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0                                  # Base de datos 0 para cache
REDIS_CACHE_DB=1                            # Base de datos 1 para cache específico
REDIS_QUEUE_DB=2                            # Base de datos 2 para colas

# ── MAIL (SMTP REAL) ──────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=upeducacionuncp@gmail.com     # Email principal del sistema
MAIL_PASSWORD=                              # App password de Gmail (16 caracteres)
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="upeducacionuncp@gmail.com"
MAIL_FROM_NAME="PS-EDU - FAEDU"

# ── IMPORTANTE: Configuración de Gmail para Producción ────────────────────────
# 1. Ve a https://myaccount.google.com/security
# 2. Activa "Verificación en 2 pasos"
# 3. Ve a "Contraseñas de aplicaciones"
# 4. Genera una contraseña para "Correo"
# 5. Copia la contraseña de 16 caracteres y pégala en MAIL_PASSWORD
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS (SI SE USA S3 PARA ARCHIVOS) ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=psedu-files
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── VITE ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── SEGURIDAD ADICIONAL ───────────────────────────────────────────────────────
# Habilitar HTTPS forzado
FORCE_HTTPS=true

# Trusted proxies (para cPanel/CloudFlare)
TRUSTED_PROXIES=*

# ── SEGURIDAD: Medidas Implementadas ──────────────────────────────────────────
# ✅ Headers de seguridad HTTP (CSP, HSTS, X-Frame-Options, etc.)
# ✅ Rate limiting en login (5 intentos / 5 minutos por IP)
# ✅ Bloqueo automático de cuentas (10 intentos / 30 minutos)
# ✅ Política de contraseñas fuertes (8+ chars, mayús, minus, núm, especial)
# ✅ Logs de seguridad completos (365 días retención)
# 
# Comandos útiles:
# - Desbloquear cuenta: php artisan user:unlock {email}
# - Ver logs: tail -f storage/logs/security.log
# - Pruebas: php test-seguridad.php
# 
# Calificación de seguridad OWASP: 9.0/10
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
# NOTAS IMPORTANTES:
# 
# 1. Generar APP_KEY: php artisan key:generate
# 2. Configurar permisos: chmod -R 775 storage bootstrap/cache
# 3. Crear symlink: php artisan storage:link
# 4. Optimizar: php artisan optimize
# 5. Migrar BD: php artisan migrate --force
# 6. Configurar Supervisor para queues (ver supervisor.conf)
# 7. Configurar cron para scheduler (ver crontab.txt)
# ══════════════════════════════════════════════════════════════════════════════
